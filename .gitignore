# Служебные файлы Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Временные файлы Microsoft Office (в т.ч. файлы-замки открытых документов)
~$*
*.tmp

# Корзина Obsidian
.trash/

# Персональные настройки Obsidian (рабочая область/кэш)
.obsidian/workspace*.json
.obsidian/cache

# Тяжёлые установочные файлы (бинарники) — не версионируются
Установочные проги ИИ/

# Домашнее задание №4 (локальные материалы, не версионируются)
Домашнее задание №4/

# Python (кэш и байт-код)
__pycache__/
*.pyc

# Python venv (Somniumsol)
.venv/
venv/
